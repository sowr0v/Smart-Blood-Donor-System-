# Smart Blood Donor System (SBDS) - Environment Configuration Template
# Duplicate this file as .env and fill in your actual credentials.
# NOTE: Never commit your actual .env file to GitHub.

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://username:password@localhost:5432/sbds_database?sslmode=require

# Twilio SMS API Gateway Credentials (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Public Contact Support Email (Optional)
PUBLIC_CONTACT_EMAIL=support@smartblood.org

